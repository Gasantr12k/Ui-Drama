		{cx,55,cx+22,75},{cx+22,75,cx+22,100}, -- прав рука
		{cx,95,cx-16,130},{cx-16,130,cx-16,168}, -- лев нога
		{cx,95,cx+16,130},{cx+16,130,cx+16,168}, -- прав нога
