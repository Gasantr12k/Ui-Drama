-- Your own logic: HOOKS["Tab/Card/Row"] = function(value) ... end
local HOOKS = getgenv().DramaHooks or {}
-- HOOKS["Player/Camera/Field of view"] = function(v) workspace.CurrentCamera.FieldOfView = v end


local state = {loaderDone = false}

----------------------------------------------------------------- LOADING SCREEN
local function runLoader()
	local BG = Color3.fromHex("0A0A0A")
	local ACCENT = Color3.fromHex("E5312B")
	local TEXT = Color3.fromHex("F2F2F2")

	-- outline of the shield (crest units 90x112), 60 points evenly spaced
	local SP = {
		10.00, 11.00, 12.27, 10.86, 14.54, 10.72, 16.81, 10.59, 19.08, 10.45, 21.35, 10.31,
		23.63, 10.17, 25.90, 10.04, 28.17, 9.90, 30.44, 9.76, 32.71, 9.62, 34.98, 9.49,
		37.25, 9.35, 39.52, 9.21, 41.79, 9.07, 44.06, 8.94, 46.33, 8.80, 48.60, 8.66,
		50.88, 8.52, 53.15, 8.39, 55.42, 8.25, 57.69, 8.11, 59.96, 7.97, 62.23, 7.83,
		64.50, 7.70, 66.77, 7.56, 69.04, 7.42, 71.31, 7.28, 73.58, 7.15, 75.85, 7.01,
		77.26, 8.71, 78.61, 10.55, 79.96, 12.38, 81.31, 14.21, 82.66, 16.04, 84.01, 17.87,
		83.78, 19.89, 82.89, 21.99, 82.00, 24.09, 81.12, 26.18, 80.24, 28.28, 79.38, 30.39,
		78.57, 32.51, 77.82, 34.66, 77.17, 36.84, 76.68, 39.06, 76.36, 41.31, 76.03, 43.56,
		75.67, 45.81, 75.28, 48.05, 74.86, 50.29, 74.40, 52.51, 73.89, 54.73, 73.34, 56.94,
		72.74, 59.13, 72.08, 61.31, 71.38, 63.47, 70.62, 65.62, 69.81, 67.74, 68.95, 69.85,
		68.03, 71.93, 66.91, 73.91, 65.72, 75.85, 64.45, 77.74, 63.10, 79.57, 61.68, 81.34,
		60.17, 83.05, 58.60, 84.69, 56.94, 86.25, 55.21, 87.73, 53.41, 89.12, 51.55, 90.42,
		49.62, 91.63, 47.63, 92.73, 45.59, 93.73, 43.52, 93.32, 41.47, 92.33, 39.45, 91.29,
		37.46, 90.19, 35.49, 89.04, 33.57, 87.83, 31.67, 86.56, 29.83, 85.24, 28.04, 83.83,
		26.33, 82.33, 24.81, 80.64, 23.34, 78.90, 21.91, 77.13, 20.54, 75.32, 19.22, 73.46,
		17.98, 71.55, 16.83, 69.59, 15.78, 67.58, 14.84, 65.51, 14.02, 63.38, 13.33, 61.22,
		12.77, 59.01, 12.35, 56.78, 12.05, 54.52, 11.92, 52.25, 11.93, 49.98, 12.09, 47.71,
		12.44, 45.46, 12.98, 43.25, 13.72, 41.10, 13.06, 39.20, 11.67, 37.40, 10.27, 35.61,
		8.87, 33.82, 7.47, 32.02, 6.07, 30.23, 4.67, 28.43, 3.28, 26.64, 2.10, 24.83,
		3.23, 22.85, 4.36, 20.88, 5.49, 18.90, 6.61, 16.93, 7.74, 14.95, 8.87, 12.98,
	}


	local function opt(name, default)
		local v = player:GetAttribute(name)
		if v == nil then return default end
		return v
	end
	do -- wait until the server has loaded the saved settings (max 2 s)
		local w = os.clock()
		while not player:GetAttribute("Drama_Ready") and os.clock() - w < 2 do task.wait() end
	end
	if not opt("Drama_LoadingScreen", true) then state.loaderDone = true; return end
	local ANIM = opt("Drama_LogoAnimation", true)

	ReplicatedFirst:RemoveDefaultLoadingScreen()
	pcall(function() ContentProvider:PreloadAsync({IMG.glow, IMG.shield, IMG.letters, IMG.ribbon}) end)

	local function new(class, props, parent)
		local o = Instance.new(class)
		for k, v in pairs(props) do o[k] = v end
		o.Parent = parent
		return o
	end
	local function clamp01(x) return math.clamp(x, 0, 1) end
	local function easeOut(p) return 1 - (1 - p) * (1 - p) end
	local function easeInOut(p) return -(math.cos(math.pi * p) - 1) / 2 end
	local function easeBack(p) return 1 + 2.4 * (p - 1) ^ 3 + 1.4 * (p - 1) ^ 2 end
	local V2, UD = Vector2.new, UDim2.fromOffset

	-- screen
	local gui = new("ScreenGui", {Name = "DramaLoader", ResetOnSpawn = false, IgnoreGuiInset = true,
		DisplayOrder = 1000000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, playerGui)
	pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None end)
	local bg = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = BG, BorderSizePixel = 0, ZIndex = 1}, gui)
	local content = new("CanvasGroup", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 2}, gui)
	local contentScale = new("UIScale", {Scale = 1}, content)
	local skip = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, ZIndex = 10}, gui)
	task.wait()
	local vmin = math.min(gui.AbsoluteSize.X, gui.AbsoluteSize.Y)

	-- sizes (HTML px -> screen px)
	local Wc = math.clamp(vmin * 0.30, 110, 240)
	local Hc = Wc * 112 / 90
	local u = Hc / 112          -- one crest unit in pixels
	local k = Wc / 170          -- scale factor against the HTML version
	local P = 12 * u            -- padding so nothing gets clipped by the CanvasGroup

	-- glow
	local gs = math.min(vmin * 0.7, 520 * k)
	local glow = new("ImageLabel", {AnchorPoint = V2(.5, .5), Position = UDim2.fromScale(.5, .5), BackgroundTransparency = 1,
		Image = IMG.glow, ImageColor3 = ACCENT, ImageTransparency = 1, Size = UD(gs, gs), ZIndex = 1}, content)

	-- crest
	local crest = new("CanvasGroup", {AnchorPoint = V2(.5, .5), Position = UDim2.fromScale(.5, .5),
		Size = UD(Wc + 2 * P, Hc + 2 * P), BackgroundTransparency = 1, ZIndex = 3}, content)
	local crestScale = new("UIScale", {Scale = 1}, crest)
	local art = new("Frame", {Position = UD(P, P), Size = UD(Wc, Hc), BackgroundTransparency = 1}, crest)

	local mask = new("Frame", {Size = UD(Wc, 0), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 1}, art)
	new("ImageLabel", {Size = UD(Wc, Hc), BackgroundTransparency = 1, Image = IMG.shield, ImageColor3 = TEXT}, mask)

	-- ribbon: sliced into strips, every strip waves on its own
	local N, RW, RH = 30, 810, 306
	local stripW = Wc / N
	local strips = {}
	for i = 0, N - 1 do
		strips[i] = new("ImageLabel", {BackgroundTransparency = 1, Image = IMG.ribbon, ImageColor3 = TEXT, ImageTransparency = 1,
			ImageRectOffset = V2(i * RW / N, 0), ImageRectSize = V2(RW / N, RH), Size = UD(stripW + 1, 34 * u), ZIndex = 1}, art)
	end
	local function wave(x, t, a)
		local d = math.abs(x - 45) / 37
		return a * (x > 45 and 1.5 or 1) * (2.4 * d * math.sin(x * .21 - t * 5.2) + 1.1 * d * math.sin(x * .5 - t * 8.6))
	end
	local function ramp(t)
		local q = clamp01((t - 1) / 2.2)
		return q * q * (3 - 2 * q)
	end

	-- drops
	local D = {{28, 7.6, 2.2}, {47.6, 2.4, 3.6}, {35.6, 19.6, 3.2}, {26.8, 24, 2.6}, {35.4, 29, 1.6}, {30.2, 43.4, .9}, {38.6, 50.8, 2}}
	local drops = {}
	for i, c in ipairs(D) do
		local f = new("Frame", {AnchorPoint = V2(.5, .5), BackgroundColor3 = ACCENT, BackgroundTransparency = 1,
			BorderSizePixel = 0, Size = UD(0, 0), ZIndex = 2}, art)
		new("UICorner", {CornerRadius = UDim.new(1, 0)}, f)
		drops[i] = f
	end

	-- spark running along the outline
	local NP = #SP / 2
	local function sparkPos(s)
		local idx = s * NP
		local i0 = math.floor(idx)
		local f = idx - i0
		local i1 = (i0 + 1) % NP
		i0 = i0 % NP
		return (SP[2 * i0 + 1] + (SP[2 * i1 + 1] - SP[2 * i0 + 1]) * f) * u, (SP[2 * i0 + 2] + (SP[2 * i1 + 2] - SP[2 * i0 + 2]) * f) * u
	end
	local sparkGlow = new("ImageLabel", {AnchorPoint = V2(.5, .5), BackgroundTransparency = 1, Image = IMG.glow,
		ImageColor3 = ACCENT, ImageTransparency = 1, Size = UD(16 * u, 16 * u), ZIndex = 3}, art)
	local dots = {}
	for j = 0, 5 do
		local d = 3.6 * u * (1 - .08 * j)
		dots[j] = new("Frame", {AnchorPoint = V2(.5, .5), BackgroundColor3 = ACCENT, BackgroundTransparency = 1,
			BorderSizePixel = 0, Size = UD(d, d), ZIndex = 4}, art)
		new("UICorner", {CornerRadius = UDim.new(1, 0)}, dots[j])
	end

	-- DRAMA letters
	local letterH = 44 * k
	local cellW = letterH * 192 / 224
	local letters = {}
	for i = 0, 4 do
		letters[i] = new("ImageLabel", {AnchorPoint = V2(.5, .5), BackgroundTransparency = 1, Image = IMG.letters, ImageColor3 = ACCENT,
			ImageTransparency = 1, ImageRectOffset = V2(i * 192, 0), ImageRectSize = V2(192, 224), Size = UD(cellW + 1, letterH), ZIndex = 4}, content)
	end

	-- rings on the beat
	local rings = {}
	local function spawnRing(t, big)
		if not ANIM then return end
		local f = new("Frame", {AnchorPoint = V2(.5, .5), Position = UDim2.fromScale(.5, .5), BackgroundTransparency = 1,
			Size = UD(0, 0), ZIndex = 5}, content)
		new("UICorner", {CornerRadius = UDim.new(1, 0)}, f)
		local st = new("UIStroke", {Color = ACCENT, Thickness = 1.5 * math.max(1, k), Transparency = 1}, f)
		table.insert(rings, {f = f, st = st, t0 = t, big = big})
	end

	-- music (optional)
	local music
	if MUSIC_ID ~= "" then
		music = new("Sound", {SoundId = MUSIC_ID, Volume = MUSIC_VOLUME}, SoundService)
		music:Play()
	end

	-- timeline
	local t0 = os.clock()
	local events, endT, fadeT = {}, nil, nil
	local thumpT = -10
	local function at(tm, fn) table.insert(events, {tm, fn}) end
	local function startFade(t)
		if fadeT then return end
		fadeT = t
		if music then TweenService:Create(music, TweenInfo.new(.4), {Volume = 0}):Play() end
	end
	local function finishShield(t)
		if endT then return end
		endT = t
		spawnRing(t, true)
		at(t + 1.25, function(tt) spawnRing(tt, true) end)
		at(t + 2.7, startFade)
	end
	for i, tm in ipairs({1.75, 3.0, 3.75, 5.0}) do
		at(tm, function(t)
			spawnRing(t, i == 1)
			if ANIM then thumpT = t end
		end)
	end
	skip.Activated:Connect(function()
		if not fadeT then startFade(os.clock() - t0) end
	end)

	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		for i = #events, 1, -1 do
			if events[i] and t >= events[i][1] then
				local e = table.remove(events, i)
				e[2](t)
			end
		end
		if not endT and not fadeT and ((t >= 6 and game:IsLoaded()) or t >= 14) then finishShield(t) end

		-- glow
		local ge = easeOut(clamp01(t / 4.5))
		local gsz = gs * (.7 + .3 * ge)
		glow.Size = UD(gsz, gsz)
		glow.ImageTransparency = 1 - .22 * ge

		-- shield reveal (top to bottom)
		local sp = ANIM and easeInOut(clamp01(t / 1.3)) or 1
		mask.Size = UD(Wc, Hc * sp)
		if sp >= 1 and mask.ClipsDescendants then mask.ClipsDescendants = false end

		-- ribbon
		local rp = ANIM and clamp01((t - .9) / .7) or 1
		local amp = ANIM and ramp(t) or 0
		for i = 0, N - 1 do
			local xc = (i + .5) * 90 / N
			strips[i].ImageTransparency = 1 - clamp01((rp * (N + 4) - i) / 4)
			strips[i].Position = UD(i * stripW, (78 + wave(xc, t, amp)) * u)
		end

		-- drops
		for i, c in ipairs(D) do
			local p = ANIM and clamp01((t - 1.75 - (i - 1) * .13) / .5) or (t > 1.75 and 1 or 0)
			local e = easeBack(p)
			local d = 2 * c[3] * u * (.6 + .4 * e)
			drops[i].Size = UD(d, d)
			drops[i].Position = UD(c[1] * u, c[2] * u - 12 * u * (1 - e))
			drops[i].BackgroundTransparency = 1 - clamp01(p * 2)
		end

		-- spark
		if ANIM and t > 1.75 then
			local on = clamp01((t - 1.75) / .3)
			local s = ((t - 1.75) / 1.7) % 1
			for j = 0, 5 do
				local x, y = sparkPos((s - j * (.13 / 6)) % 1)
				dots[j].Position = UD(x, y)
				dots[j].BackgroundTransparency = 1 - on * (1 - j * .1)
				if j == 0 then
					sparkGlow.Position = UD(x, y)
					sparkGlow.ImageTransparency = 1 - on * .6
				end
			end
		end

		-- crest transform: sway from the top, thump on the beat, leave on the end
		local theta = (ANIM and t > 1.5) and 2 * math.sin(2 * math.pi * (t - 1.5) / 2.6) or 0
		local q = endT and clamp01((t - endT) / .6) or 0
		local qq = q * q
		local thump = 1 + .05 * math.sin(math.pi * clamp01((t - thumpT) / .28))
		local r = math.rad(theta)
		crest.Rotation = theta
		crest.Position = UDim2.new(.5, -Hc / 2 * math.sin(r), .5, Hc / 2 * (math.cos(r) - 1) - 10 * k * qq)
		crestScale.Scale = thump * (1 - .06 * qq)
		crest.GroupTransparency = qq

		-- letters
		for i = 0, 4 do
			local p = endT and clamp01((t - endT - (.25 + i * .15)) / .38) or 0
			local e = easeOut(p)
			letters[i].ImageTransparency = 1 - e
			letters[i].Position = UDim2.new(.5, (i - 2) * cellW, .5, 5 * k * (1 - e))
		end

		-- rings
		for i = #rings, 1, -1 do
			local rg = rings[i]
			local dur = rg.big and 1.5 or 1.1
			local p = (t - rg.t0) / dur
			if p >= 1 then
				rg.f:Destroy()
				table.remove(rings, i)
			else
				local e = 1 - (1 - p) ^ 3
				local sc = .55 + ((rg.big and 3.6 or 2.4) - .55) * e
				rg.f.Size = UD(Wc * sc, Wc * sc)
				rg.st.Transparency = 1 - (rg.big and .7 or .5) * (1 - p)
			end
		end

		-- fade out and clean up
		if fadeT then
			local p = clamp01((t - fadeT) / .4)
			content.GroupTransparency = p
			bg.BackgroundTransparency = p
			contentScale.Scale = 1 + .04 * p
			if p >= 1 then
				conn:Disconnect()
				gui:Destroy()
				state.loaderDone = true
				if music then music:Destroy() end
			end
		end
	end)
end
task.spawn(runLoader)

----------------------------------------------------------------- MENU + WATERMARK
do
	local C = {
		bg = Color3.fromHex("0A0A0A"), panel = Color3.fromHex("111111"), card = Color3.fromHex("1A1A1A"),
		line = Color3.fromHex("252525"), line2 = Color3.fromHex("363636"), t1 = Color3.fromHex("F2F2F2"),
		t2 = Color3.fromHex("8C8C8C"), t3 = Color3.fromHex("5A5A5A"), accent = Color3.fromHex("E5312B"),
		swoff = Color3.fromHex("2C2C2C"), chk = Color3.fromHex("0B0B0B"), white = Color3.new(1, 1, 1),
	}
	local PAL = {"22D3EE", "A3E635", "F59E0B", "E879F9", "F2F2F2"}
	local FONT, FONTB = Enum.Font.GothamMedium, Enum.Font.GothamBold

	----------------------------------------------------------------- data
	local ICON = {crosshair=0, user=1, users=2, globe=3, list=4, sliders=5, folder=6, eye=7, sun=8, speaker=9, star=10, shield=11, chat=12, cpu=13, save=14, move=15, check=16, chev=17}
	local TABS = {
		{
			name="Aim",
			group="Gameplay",
			icon="crosshair",
			cards={
				{
					col=0,
					title="Crosshair",
					icon="crosshair",
					on=true,
					rows={
						{t="k", l="Hotkey", v="Mouse 2"},
						{t="c", l="Dynamic spread", v=true},
						{t="c", l="Center dot", v=true},
						{t="s", l="Size", min=2, max=40, v=14, u="px"},
						{t="s", l="Gap", min=0, max=20, v=4, u="px"},
						{t="d", l="Style", o={"Classic", "Cross", "Circle"}, v=1},
						{t="c", l="Outline", v=false},
						{
							t="g",
							l="Customize",
							rows={
								{t="s", l="Thickness", min=1, max=6, v=2, u="px"},
								{t="s", l="Opacity", min=0, max=100, v=100, u="%"},
								{t="o", l="Color", v=1},
								{t="c", l="Dynamic gap", v=false},
							},
							open=false,
						},
					},
				},
				{
					col=0,
					title="Zoom",
					icon="eye",
					on=false,
					rows={
						{t="k", l="Zoom key", v="Mouse 2"},
						{t="c", l="Toggle mode", v=false},
						{t="s", l="Level", min=1, max=8, v=3, u="×"},
						{t="s", l="Speed", min=1, max=10, v=6, u=""},
						{t="o", l="Vignette", v=1},
					},
				},
				{
					col=1,
					title="Sensitivity",
					icon="sliders",
					on=true,
					rows={
						{t="c", l="Raw input", v=true},
						{t="s", l="Base", min=1, max=30, v=8, u=""},
						{t="s", l="Zoomed", min=1, max=30, v=6, u=""},
						{t="s", l="Curve", min=0, max=100, v=20, u="%"},
						{t="d", l="Axis", o={"Both", "Horizontal", "Vertical"}, v=1},
						{t="c", l="Invert Y", v=false},
						{
							t="g",
							l="Advanced",
							rows={
								{t="s", l="Acceleration", min=0, max=100, v=0, u="%"},
								{t="s", l="Deadzone", min=0, max=30, v=2, u="%"},
								{t="c", l="Snap to target", v=false},
							},
							open=false,
						},
					},
				},
				{
					col=1,
					title="Feedback",
					icon="star",
					on=true,
					rows={
						{t="c", l="Hit marker", v=true},
						{t="d", l="Sound", o={"Tick", "Pop", "Chime"}, v=1},
						{t="s", l="Volume", min=0, max=100, v=60, u="%"},
						{t="o", l="Marker color", v=3},
						{
							t="g",
							l="More",
							rows={
								{t="s", l="Marker size", min=4, max=32, v=12, u="px"},
								{t="s", l="Duration", min=100, max=1000, v=300, u="ms"},
								{t="c", l="Kill confirm", v=true},
							},
							open=false,
						},
					},
				},
			},
		},
		{
			name="Player",
			group="Gameplay",
			icon="user",
			cards={
				{
					col=0,
					title="Movement",
					icon="move",
					on=true,
					rows={
