	getgenv().DramaTABS = TABS
	local ROW, CARD = {}, {}
	local function initRows(rows, base)
		for _, r in ipairs(rows) do
			r.path = base .. "/" .. r.l
			if r.t == "g" then
				initRows(r.rows, r.path)
			else
				r.val = r.v
				if r.path == "Configs/Menu/Menu key" then r.val = "RightShift" end
				ROW[r.path] = r
			end
		end
	end
	for _, tab in ipairs(TABS) do
		for _, card in ipairs(tab.cards) do
			card.path = tab.name .. "/" .. card.title
			card.enabled = card.on
			CARD[card.path] = card
			if card.rows then initRows(card.rows, card.path) end
		end
	end
	local function V(path) local r = ROW[path]; return r and r.val end

	local profiles, active = {}, nil
	local function snapshot()
		local s = {}
		for p, r in pairs(ROW) do s[p] = r.val end
		for p, c in pairs(CARD) do s[p .. "!on"] = c.enabled end
		return s
	end
	local function applySnap(s)
		for p, r in pairs(ROW) do
			local v = s[p]
			if v ~= nil and type(v) == type(r.val) then r.val = v end
		end
		for p, c in pairs(CARD) do
			local v = s[p .. "!on"]
			if type(v) == "boolean" then c.enabled = v end
		end
	end

	----------------------------------------------------------------- saving
	local remote = ReplicatedStorage:WaitForChild("DramaSave", 8)
	local function callServer(...)
		if not remote then return nil end
		local args = table.pack(...)
		local ok, res = pcall(function() return remote:InvokeServer(table.unpack(args, 1, args.n)) end)
		return ok and res or nil
	end
	do
		local data = callServer("load")
		if type(data) == "table" then
			if type(data.rows) == "table" then applySnap(data.rows) end
			if type(data.profiles) == "table" then profiles = data.profiles end
			if type(data.active) == "number" then active = data.active end
		end
		if #profiles == 0 then
			profiles = {{n = "Default", t = os.time(), s = snapshot()}}
			active = 1
		end
	end
	local saveToken = 0
	local function flush()
		task.spawn(callServer, "save", {rows = snapshot(), profiles = profiles, active = active})
	end
	local function saveSoon()
		saveToken += 1
		local tok = saveToken
		task.delay(1.5, function() if tok == saveToken then flush() end end)
	end

	----------------------------------------------------------------- helpers
	local function new(class, props, parent)
		local o = Instance.new(class)
		for k, v in pairs(props) do o[k] = v end
		o.Parent = parent
		return o
	end
	local function tw(o, t, props, style, dir)
		local tween = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
		tween:Play()
		return tween
	end
	local function corner(o, r) return new("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
	local function stroke(o, c) return new("UIStroke", {Color = c, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o) end
	local function text(parent, str, size, color, props)
		local l = new("TextLabel", {BackgroundTransparency = 1, Text = str, TextSize = size, TextColor3 = color, Font = FONT,
			TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromScale(1, 1), TextTruncate = Enum.TextTruncate.AtEnd}, parent)
		for k, v in pairs(props or {}) do l[k] = v end
		return l
	end
	local function icon(parent, name, px, color, props)
		local i = ICON[name] or 0
		local o = new("ImageLabel", {BackgroundTransparency = 1, Image = IMG.icons, ImageColor3 = color, Size = UDim2.fromOffset(px, px),
			ImageRectOffset = Vector2.new((i % 5) * 128, (i // 5) * 128), ImageRectSize = Vector2.new(128, 128)}, parent)
		for k, v in pairs(props or {}) do o[k] = v end
		return o
	end
	local function pretty(name)
		local m = name:match("^MouseButton(%d)$")
		if m then return "Mouse " .. m end
		if name:find(" ") or name:find("+", 1, true) then return name end
		return (name:gsub("(%l)(%u)", "%1 %2"))
	end
	local function savedText(t)
		local d = math.floor((os.time() - t) / 86400)
		if d <= 0 then return "Saved today" end
		if d == 1 then return "Saved yesterday" end
		if d < 7 then return "Saved " .. d .. " days ago" end
		local w = math.floor(d / 7)
		return "Saved " .. w .. (w == 1 and " week ago" or " weeks ago")
	end

	----------------------------------------------------------------- sounds
	local soundCache, lastTick = {}, 0
	local function snd(name)
		local card = CARD["Configs/Menu sounds"]
		local vol = (V("Configs/Menu sounds/Volume") or 0) / 100
		if not card.enabled or vol <= 0 then return end
		if name == "appear" then
			if not V("Configs/Menu sounds/Appear sounds") then return end
		elseif not V("Configs/Menu sounds/Click sounds") then
			return
		end
		if name == "tick" then
			if os.clock() - lastTick < .04 then return end
			lastTick = os.clock()
		end
		local pr = ROW["Configs/Menu sounds/Sound pack"]
		local id = (SOUNDS[pr.o[pr.val]] or {})[name] or SOUNDS.Soft[name]
		if not id or id == "" then return end
		local s = soundCache[id]
		if not s then s = new("Sound", {SoundId = id}, SoundService); soundCache[id] = s end
		s.Volume = vol * .6
		s.TimePosition = 0
		s:Play()
	end

