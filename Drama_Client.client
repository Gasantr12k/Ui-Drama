	text(closeBtn, "×", 22, C.t2, {TextXAlignment = Enum.TextXAlignment.Center})
	local body = new("ScrollingFrame", {Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 1, -52), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = C.line2, CanvasSize = UDim2.fromOffset(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y}, main)
	local grip = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(28, 28), ZIndex = 20}, win)
	local gripIcon = icon(grip, "move", 16, C.t3, {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Rotation = 45})
	local overlay = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 50}, win)

	----------------------------------------------------------------- dropdown + key listening
	local closeDropdown, openDropdown
	do
		local catcher, menu
		function closeDropdown()
			if catcher then catcher:Destroy(); catcher = nil end
			if menu then menu:Destroy(); menu = nil end
		end
		function openDropdown(btn, row, onPick)
			closeDropdown()
			snd("click")
			catcher = new("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1}, overlay)
			catcher.Activated:Connect(closeDropdown)
			local rel = (btn.AbsolutePosition - overlay.AbsolutePosition) / S
			menu = new("CanvasGroup", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromOffset(rel.X + btn.AbsoluteSize.X / S, rel.Y + btn.AbsoluteSize.Y / S + 4),
				Size = UDim2.fromOffset(math.max(btn.AbsoluteSize.X / S, 120), #row.o * 28 + 8), BackgroundColor3 = Color3.fromHex("141414"),
				BorderSizePixel = 0, ZIndex = 2, GroupTransparency = 1}, overlay)
			corner(menu, 8); stroke(menu, C.line2)
			new("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4)}, menu)
			new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, menu)
			for i, o in ipairs(row.o) do
				local b = new("TextButton", {Text = o, TextSize = 12, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
					TextColor3 = i == row.val and C.accent or C.t2, BackgroundColor3 = C.white, BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 28), LayoutOrder = i}, menu)
				corner(b, 4)
				new("UIPadding", {PaddingLeft = UDim.new(0, 8)}, b)
				b.MouseEnter:Connect(function() b.BackgroundTransparency = .94; if i ~= row.val then b.TextColor3 = C.t1 end end)
				b.MouseLeave:Connect(function() b.BackgroundTransparency = 1; if i ~= row.val then b.TextColor3 = C.t2 end end)
				b.Activated:Connect(function()
					snd("pick")
					closeDropdown()
					onPick(i)
				end)
			end
			tw(menu, .12, {GroupTransparency = 0})
		end
	end

	local listen -- {row, btn}
	local function stopListen(name)
		if not listen then return end
		local row, btn = listen.row, listen.btn
		listen = nil
		if name then row.val = name; snd("pick") end
		if btn.Parent then
			btn.Text = pretty(row.val)
			btn.TextColor3 = C.t2
			btn.BackgroundTransparency = 1
		end
		if name then saveSoon() end
	end

	----------------------------------------------------------------- settings reactions
	local hud, updateHud
	local function changed(row)
		saveSoon()
		local h = HOOKS[row.path]
		if h then task.spawn(h, row.val) end
		if row.path == "Miscellaneous/Performance/Show watermark" and updateHud then updateHud() end
	end

	----------------------------------------------------------------- controls
	local conns = {}
	local function buildRow(parent, row, order, card)
		if row.t == "g" then
			local g = new("Frame", {Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, LayoutOrder = order, ClipsDescendants = true}, parent)
			local head = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32)}, g)
			local gl = text(head, row.l, 13, C.t2, {Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -48, 1, 0)})
			local chev = icon(head, "chev", 14, C.t2, {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -12, .5, 0)})
			local inner = new("Frame", {Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, #row.rows * 32), BackgroundTransparency = 1}, g)
			new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, inner)
			for i, r in ipairs(row.rows) do
				local sub = new("Frame", {Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, LayoutOrder = i}, inner)
				local rf = buildRow(sub, r, i, card)
				rf.Position = UDim2.fromOffset(12, 0)
				rf.Size = UDim2.new(1, -12, 0, 32)
			end
			head.Activated:Connect(function()
				row.open = not row.open
				snd("click")
				tw(g, .2, {Size = UDim2.new(1, 0, 0, 32 + (row.open and #row.rows * 32 or 0))})
				tw(chev, .2, {Rotation = row.open and 180 or 0})
				gl.TextColor3 = row.open and C.t1 or C.t2
			end)
			if row.open then g.Size = UDim2.new(1, 0, 0, 32 + #row.rows * 32); chev.Rotation = 180 end
			return g
		end
		local f = new("Frame", {Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.white, BackgroundTransparency = 1, LayoutOrder = order}, parent)
		local ctlW = ({c = 16, s = 144, d = 112, k = 100, o = 16})[row.t]
		local lbl = text(f, row.l, 13, C.t2, {Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -(24 + ctlW + 8), 1, 0)})
		f.MouseEnter:Connect(function() f.BackgroundTransparency = .975 end)
		f.MouseLeave:Connect(function() f.BackgroundTransparency = 1 end)
		local R = Vector2.new(1, .5)

		if row.t == "c" then
			local b = new("TextButton", {Text = "", AutoButtonColor = false, AnchorPoint = R, Position = UDim2.new(1, -12, .5, 0),
				Size = UDim2.fromOffset(16, 16), BackgroundColor3 = C.chk}, f)
			corner(b, 4)
			local st = stroke(b, C.line2)
			local ck = icon(b, "check", 12, C.white, {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5)})
			local function paint(anim)
				local on = row.val
				local t = anim and .12 or 0
				tw(b, t, {BackgroundColor3 = on and C.accent or C.chk})
				tw(ck, t, {ImageTransparency = on and 0 or 1})
				st.Color = on and C.accent or C.line2
				lbl.TextColor3 = on and C.t1 or C.t2
			end
			paint(false)
			b.Activated:Connect(function()
				row.val = not row.val
				paint(true)
				snd(row.val and "on" or "off")
				changed(row)
			end)
		elseif row.t == "s" then
			local out = text(f, row.val .. (row.u or ""), 11, C.t3, {AnchorPoint = R, Position = UDim2.new(1, -12, .5, 0),
				Size = UDim2.fromOffset(36, 14), TextXAlignment = Enum.TextXAlignment.Right})
			local track = new("TextButton", {Text = "", AutoButtonColor = false, AnchorPoint = R, Position = UDim2.new(1, -56, .5, 0),
				Size = UDim2.fromOffset(100, 16), BackgroundTransparency = 1}, f)
			local bar = new("Frame", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.fromScale(0, .5), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = C.chk}, track)
			corner(bar, 3); stroke(bar, C.line2)
			local fill = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.accent, BorderSizePixel = 0}, bar)
			corner(fill, 3)
			local thumb = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = C.white, ZIndex = 2}, track)
			corner(thumb, 6)
			local function paint()
				local p = (row.val - row.min) / (row.max - row.min)
				fill.Size = UDim2.fromScale(p, 1)
				thumb.Position = UDim2.new(p, 0, .5, 0)
				out.Text = row.val .. (row.u or "")
			end
			paint()
			local dragging = false
			local function setX(x)
				local p = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
				local v = math.floor(row.min + p * (row.max - row.min) + .5)
				if v ~= row.val then
					row.val = v
					paint()
					snd("tick")
					changed(row)
				end
			end
			track.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					tw(thumb, .12, {Size = UDim2.fromOffset(11, 11)})
					setX(i.Position.X)
				end
			end)
			table.insert(conns, UIS.InputChanged:Connect(function(i)
				if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then setX(i.Position.X) end
			end))
			table.insert(conns, UIS.InputEnded:Connect(function(i)
				if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
					dragging = false
					tw(thumb, .12, {Size = UDim2.fromOffset(12, 12)})
				end
			end))
		elseif row.t == "d" then
			local b = new("TextButton", {Text = "", AutoButtonColor = false, AnchorPoint = R, Position = UDim2.new(1, -12, .5, 0),
				Size = UDim2.fromOffset(112, 24), BackgroundColor3 = C.chk}, f)
			corner(b, 4)
			local st = stroke(b, C.line)
			local t = text(b, row.o[row.val], 12, C.t2, {Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -28, 1, 0)})
			icon(b, "chev", 12, C.t2, {AnchorPoint = R, Position = UDim2.new(1, -8, .5, 0)})
			b.MouseEnter:Connect(function() st.Color = C.line2; t.TextColor3 = C.t1 end)
			b.MouseLeave:Connect(function() st.Color = C.line; t.TextColor3 = C.t2 end)
			b.Activated:Connect(function()
				openDropdown(b, row, function(i)
					row.val = i
					t.Text = row.o[i]
					changed(row)
				end)
			end)
		elseif row.t == "k" then
			local b = new("TextButton", {Text = pretty(row.val), TextSize = 13, Font = FONT, TextColor3 = C.t2, AutoButtonColor = false,
				BackgroundColor3 = C.white, BackgroundTransparency = 1, AnchorPoint = R, Position = UDim2.new(1, -12, .5, 0),
				Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X}, f)
			corner(b, 4)
			new("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)}, b)
			b.MouseEnter:Connect(function() if not listen then b.BackgroundTransparency = .94; b.TextColor3 = C.t1 end end)
			b.MouseLeave:Connect(function() if not listen or listen.btn ~= b then b.BackgroundTransparency = 1; b.TextColor3 = C.t2 end end)
			b.Activated:Connect(function()
				if listen then stopListen(nil) end
				snd("click")
				listen = {row = row, btn = b}
				b.Text = "Press a key…"
				b.TextColor3 = C.accent
				b.BackgroundColor3 = C.accent
				b.BackgroundTransparency = .88
			end)
		elseif row.t == "o" then
			local b = new("TextButton", {Text = "", AutoButtonColor = false, AnchorPoint = R, Position = UDim2.new(1, -12, .5, 0),
				Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.fromHex(PAL[row.val])}, f)
			corner(b, 8)
			stroke(b, C.line2)
			b.Activated:Connect(function()
				row.val = row.val % #PAL + 1
				b.BackgroundColor3 = Color3.fromHex(PAL[row.val])
				snd("pick")
				changed(row)
			end)
		end
		return f
	end

	----------------------------------------------------------------- cards
	local shown = {}       -- cards currently on screen
	local renderCurrent    -- forward
	local function profileBtn(parent, label, props)
		local b = new("TextButton", {Text = label, TextSize = 12, Font = FONT, TextColor3 = C.t1, AutoButtonColor = false,
			BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X}, parent)
		for k, v in pairs(props or {}) do b[k] = v end
		corner(b, 4); stroke(b, C.line2)
		new("UIPadding", {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12)}, b)
		b.MouseEnter:Connect(function() if b.Active then b.BackgroundColor3 = C.white; b.BackgroundTransparency = .94 end end)
		b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
		return b
	end

	local function buildProfiles(list, foot)
		for _, c in ipairs(list:GetChildren()) do if not c:IsA("UIListLayout") then c:Destroy() end end
		for _, c in ipairs(foot:GetChildren()) do c:Destroy() end
		for i, p in ipairs(profiles) do
			local f = new("Frame", {Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, LayoutOrder = i}, list)
			text(f, p.n, 13, C.t1, {Position = UDim2.fromOffset(12, 7), Size = UDim2.new(1, -150, 0, 18)})
			text(f, savedText(p.t), 11, C.t3, {Position = UDim2.fromOffset(12, 25), Size = UDim2.new(1, -150, 0, 14)})
			local del = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, .5),
				Position = UDim2.new(1, -12, .5, 0), Size = UDim2.fromOffset(28, 28)}, f)
			corner(del, 4); stroke(del, C.line2)
			text(del, "×", 18, C.t2, {TextXAlignment = Enum.TextXAlignment.Center})
			if active == i then
				local bd = new("TextLabel", {Text = "Active", TextSize = 11, Font = FONT, TextColor3 = C.accent, BackgroundColor3 = C.accent,
					BackgroundTransparency = .88, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -48, .5, 0),
					Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X}, f)
				corner(bd, 4)
				new("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)}, bd)
			else
				local ld = profileBtn(f, "Load", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -48, .5, 0)})
				ld.Activated:Connect(function()
					snd("pick")
					applySnap(p.s)
					active = i
					saveSoon()
					renderCurrent(true)
				end)
			end
			del.Activated:Connect(function()
				snd("del")
				table.remove(profiles, i)
				if active == i then active = nil elseif active and active > i then active -= 1 end
				saveSoon()
				buildProfiles(list, foot)
			end)
		end
		if #profiles == 0 then
			text(list, "No profiles yet", 12, C.t3, {Size = UDim2.new(1, 0, 0, 48), TextXAlignment = Enum.TextXAlignment.Center})
		end
		local full = #profiles >= 6
		local nb = profileBtn(foot, full and "Profile limit reached" or "New profile", {Position = UDim2.fromOffset(12, 8)})
		if full then nb.Active = false; nb.TextTransparency = .6 end
		nb.Activated:Connect(function()
			if #profiles >= 6 then return end
			snd("add")
			local n = #profiles + 1
			local names = {}
			for _, p in ipairs(profiles) do names[p.n] = true end
			while names["Profile " .. n] do n += 1 end
			table.insert(profiles, {n = "Profile " .. n, t = os.time(), s = snapshot()})
			saveSoon()
			buildProfiles(list, foot)
		end)
	end

	local function buildCard(parent, card, idx)
		local shell = new("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.card,
			BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = idx}, parent)
		corner(shell, 8)
		local st = stroke(shell, C.line)
		st.Transparency = 1
		local g = new("CanvasGroup", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
			GroupTransparency = 1}, shell)
		corner(g, 8)
		new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, g)
		local head = new("Frame", {Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, LayoutOrder = 1}, g)
		new("Frame", {AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = C.line, BorderSizePixel = 0}, head)
		icon(head, card.icon, 16, C.accent, {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 12, .5, 0)})
		text(head, card.title, 13, C.t1, {Position = UDim2.fromOffset(36, 0), Size = UDim2.new(1, -90, 1, 0), Font = FONTB})
		local entry = {shell = shell, g = g, st = st}
		table.insert(shown, entry)

		if card.p then
			local list = new("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2}, g)
			new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, list)
			local foot = new("Frame", {Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, LayoutOrder = 3}, g)
			new("Frame", {Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = C.line, BorderSizePixel = 0}, foot)
			buildProfiles(list, foot)
			return entry
		end

		local rowsG = new("CanvasGroup", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2,
			GroupTransparency = card.enabled and 0 or .55}, g)
		new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, rowsG)
		new("UIPadding", {PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6)}, rowsG)
		for i, r in ipairs(card.rows) do buildRow(rowsG, r, i, card) end

		local sw = new("TextButton", {Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -12, .5, 0),
			Size = UDim2.fromOffset(34, 18), BackgroundColor3 = card.enabled and C.accent or C.swoff}, head)
		corner(sw, 9)
		local knob = new("Frame", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, card.enabled and 18 or 2, .5, 0),
			Size = UDim2.fromOffset(14, 14), BackgroundColor3 = C.white}, sw)
		corner(knob, 7)
		sw.Activated:Connect(function()
			card.enabled = not card.enabled
			tw(sw, .12, {BackgroundColor3 = card.enabled and C.accent or C.swoff})
			tw(knob, .12, {Position = UDim2.new(0, card.enabled and 18 or 2, .5, 0)})
			tw(rowsG, .2, {GroupTransparency = card.enabled and 0 or .55})
			snd(card.enabled and "on" or "off")
			if HOOKS[card.path] then task.spawn(HOOKS[card.path], card.enabled) end
			saveSoon()
		end)
		return entry
	end

	----------------------------------------------------------------- sidebar + tabs
	local cur, curToken = 0, 0
	local items = {}
	local function sideLayout()
		local y = 8
		local lastGroup
		for i, tab in ipairs(TABS) do
			if tab.group ~= lastGroup then
				lastGroup = tab.group
				y += 16
				if not items.labels then items.labels = {} end
				local lab = items.labels[tab.group]
				if not lab then
					lab = text(nav, string.upper(tab.group), 11, C.t3, {Size = UDim2.new(1, -24, 0, 14), Position = UDim2.fromOffset(12, y), Font = FONT})
					items.labels[tab.group] = lab
				end
				lab.Position = UDim2.fromOffset(12, y)
				lab.Visible = not compact
				y += compact and 0 or 20
			end
			local it = items[i]
			it.btn.Position = UDim2.fromOffset(compact and 8 or 12, y)
			it.btn.Size = UDim2.new(1, compact and -16 or -24, 0, 40)
			it.label.Visible = not compact
			it.ico.Position = compact and UDim2.new(.5, 0, .5, 0) or UDim2.new(0, 22, .5, 0)
			it.y = y
			y += 40
		end
		if items[cur] and cur > 0 then
			indicator.Position = UDim2.fromOffset(0, items[cur].y + 8)
		end
	end
	for i, tab in ipairs(TABS) do
		local b = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = C.white, BackgroundTransparency = 1}, nav)
		corner(b, 8)
		local ico = icon(b, tab.icon, 20, C.t2, {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(0, 22, .5, 0)})
		local lab = text(b, tab.name, 13, C.t2, {Position = UDim2.fromOffset(44, 0), Size = UDim2.new(1, -52, 1, 0)})
		items[i] = {btn = b, ico = ico, label = lab, y = 0}
	end

	local bodyInner = new("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1}, body)
	new("UIPadding", {PaddingTop = UDim.new(0, 16), PaddingBottom = UDim.new(0, 16), PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16)}, bodyInner)

	local function fadeIn(entry, delay)
		local info = TweenInfo.new(.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, delay)
		TweenService:Create(entry.g, info, {GroupTransparency = 0}):Play()
		TweenService:Create(entry.shell, info, {BackgroundTransparency = 0}):Play()
		TweenService:Create(entry.st, info, {Transparency = 0}):Play()
	end
	function renderCurrent(animate)
		closeDropdown()
		for _, c in ipairs(conns) do c:Disconnect() end
		table.clear(conns)
		for _, c in ipairs(bodyInner:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
		table.clear(shown)
		local tab = TABS[cur]
		local cols = {}
		for ci = 0, 1 do
			cols[ci] = new("Frame", {Position = UDim2.new(ci * .5, ci == 1 and 8 or 0, 0, 0), Size = UDim2.new(.5, -8, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1}, bodyInner)
			new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 16)}, cols[ci])
		end
		for i, card in ipairs(tab.cards) do
			local e = buildCard(cols[card.col], card, i)
			if animate then fadeIn(e, (i - 1) * .08) else e.g.GroupTransparency = 0; e.shell.BackgroundTransparency = 0; e.st.Transparency = 0 end
		end
		body.CanvasPosition = Vector2.new(0, 0)
	end
	local function selectTab(i, silent)
		if i == cur then return end
		local first = cur == 0
		cur = i
		curToken += 1
		local tok = curToken
		if not silent then snd("tab") end
		for k, it in ipairs(items) do
			local on = k == i
			tw(it.btn, .12, {BackgroundTransparency = on and .95 or 1})
			it.label.TextColor3 = on and C.t1 or C.t2
			it.ico.ImageColor3 = on and C.accent or C.t2
		end
		title.Text = TABS[i].name
		tw(indicator, .3, {Position = UDim2.fromOffset(0, items[i].y + 8)})
		if first then renderCurrent(true); return end
		for _, e in ipairs(shown) do
			tw(e.g, .2, {GroupTransparency = 1}); tw(e.shell, .2, {BackgroundTransparency = 1}); tw(e.st, .2, {Transparency = 1})
		end
		task.delay(.2, function() if tok == curToken then renderCurrent(true) end end)
	end
	for i, it in ipairs(items) do
		it.btn.Activated:Connect(function() selectTab(i) end)
		it.btn.MouseEnter:Connect(function() if cur ~= i then it.btn.BackgroundTransparency = .96 end end)
		it.btn.MouseLeave:Connect(function() if cur ~= i then it.btn.BackgroundTransparency = 1 end end)
	end
	sideLayout()

	----------------------------------------------------------------- window: open/close, drag, resize
	local isOpen, ready = false, false
	local function setOpen(open)
		if open == isOpen then return end
		isOpen = open
		closeDropdown()
		if listen then stopListen(nil) end
		if open then
			win.Visible = true
			win.Position = winBase + UDim2.fromOffset(0, 10)
			tw(win, .22, {GroupTransparency = 0, Position = winBase})
			espPreview.Visible = true
			espPreview.Position = UDim2.new(0.5, winW * S / 2 + 12, 0.5, 0) + UDim2.fromOffset(0, 10)
			tw(espPreview, .22, {GroupTransparency = 0, Position = UDim2.new(0.5, winW * S / 2 + 12, 0.5, 0)})
			snd("open")
			snd("appear")
		else
			tw(win, .18, {GroupTransparency = 1, Position = winBase + UDim2.fromOffset(0, 10)})
			tw(espPreview, .18, {GroupTransparency = 1, Position = UDim2.new(0.5, winW * S / 2 + 12, 0.5, 10)})
			task.delay(.2, function() if not isOpen then win.Visible = false; espPreview.Visible = false end end)
			flush()
		end
		if updateHud then updateHud() end
	end
	closeBtn.Activated:Connect(function() setOpen(false) end)

	local drag
	top.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			drag = {kind = "move", start = i.Position, base = winBase}
		end
	end)
	grip.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			drag = {kind = "size", start = i.Position, w = winW, h = winH}
			gripIcon.ImageColor3 = C.accent
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if not drag or not (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then return end
		local d = i.Position - drag.start
		if drag.kind == "move" then
			winBase = UDim2.new(drag.base.X.Scale, drag.base.X.Offset + d.X, drag.base.Y.Scale, drag.base.Y.Offset + d.Y)
			win.Position = winBase
		else
			winW = math.clamp(drag.w + d.X / S, MINW, vp.X / S - 8)
			winH = math.clamp(drag.h + d.Y / S, MINH, vp.Y / S - 8)
			win.Size = UDim2.fromOffset(winW, winH)
			local c = winW < 640
			if c ~= compact then
				compact = c
				sideW = c and 64 or 224
				side.Size = UDim2.new(0, sideW, 1, 0)
				main.Position = UDim2.fromOffset(sideW, 0)
				main.Size = UDim2.new(1, -sideW, 1, 0)
				logoText.Visible = not c
				logoCrest.Position = c and UDim2.new(.5, -12, .5, 0) or UDim2.new(0, 20, .5, 0)
				sideLayout()
			end
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if drag and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
			drag = nil
			gripIcon.ImageColor3 = C.t3
		end
	end)
	logoText.Visible = not compact
	if compact then logoCrest.Position = UDim2.new(.5, -12, .5, 0) end

	----------------------------------------------------------------- watermark
	hud = new("Frame", {AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 12), Size = UDim2.fromOffset(0, 32),
		AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = C.panel, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 60}, gui)
	local hudScale = new("UIScale", {Scale = math.clamp(S, .85, 1.1)}, hud)
	corner(hud, 8)
	local hudStroke = stroke(hud, C.line)
	hudStroke.Transparency = 1
	new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder}, hud)
	new("UIPadding", {PaddingRight = UDim.new(0, 16)}, hud)
	local hb = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromOffset(16 + 14 * 960 / 224 + 12, 32), LayoutOrder = 1}, hud)
	local hbIcon = new("ImageLabel", {BackgroundTransparency = 1, Image = IMG.letters, ImageColor3 = C.accent, ImageTransparency = 1,
		AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 16, .5, 0), Size = UDim2.fromOffset(14 * 960 / 224, 14)}, hb)
	local function hudText(order)
		return new("TextLabel", {BackgroundTransparency = 1, Text = "", RichText = true, TextSize = 12, Font = FONT, TextColor3 = C.t2,
			TextTransparency = 1, Size = UDim2.fromOffset(0, 32), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = order}, hud)
	end
	local function hudDiv(order)
		local d = new("Frame", {Size = UDim2.fromOffset(1, 14), BackgroundColor3 = C.line2, BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = order}, hud)
		return d
	end
	local tFps, tPing, tName = hudText(2), hudText(4), hudText(6)
	local dividers = {hudDiv(3), hudDiv(5)}
	local hudParts = {tFps, tPing, tName}
	tName.Text = '<font color="#F2F2F2">' .. player.DisplayName .. "</font>"
	local hudVisible = false
	function updateHud()
		local show = V("Miscellaneous/Performance/Show watermark")
		local on = hudVisible and (show or not isOpen)
		local a = on and 0 or 1
		hud.Visible = true
		tw(hud, .25, {BackgroundTransparency = on and .18 or 1})
		tw(hudStroke, .25, {Transparency = a})
		for _, t in ipairs(hudParts) do tw(t, .25, {TextTransparency = a}) end
		for _, d in ipairs(dividers) do tw(d, .25, {BackgroundTransparency = a}) end
		tw(hbIcon, .25, {ImageTransparency = on and (isOpen and .5 or 0) or 1})
		hb.Active = on
	end
	hb.Activated:Connect(function() if ready then setOpen(not isOpen) end end)
	do
		local acc, frames = 0, 0
		RunService.RenderStepped:Connect(function(dt)
			acc += dt; frames += 1
			if acc >= .5 then
				local fps = math.floor(frames / acc + .5)
				local ping = math.floor(player:GetNetworkPing() * 1000 + .5)
				tFps.Text = '<font color="#F2F2F2">' .. fps .. "</font> fps"
				tPing.Text = '<font color="#F2F2F2">' .. ping .. "</font> ms"
				acc, frames = 0, 0
			end
		end)
	end

	----------------------------------------------------------------- menu key
	UIS.InputBegan:Connect(function(input, gp)
		if listen then
			local kc, ut = input.KeyCode, input.UserInputType
			if kc == Enum.KeyCode.Escape then stopListen(nil)
			elseif kc ~= Enum.KeyCode.Unknown then stopListen(kc.Name)
			elseif ut == Enum.UserInputType.MouseButton2 or ut == Enum.UserInputType.MouseButton3 then stopListen(ut.Name)
			elseif ut == Enum.UserInputType.MouseButton1 then stopListen(nil) end
			return
		end
		if gp or not ready then return end
		local key = V("Configs/Menu/Menu key")
		if input.KeyCode.Name == key or input.UserInputType.Name == key then setOpen(not isOpen) end
	end)

	----------------------------------------------------------------- start (after the loading screen)
	for p, h in pairs(HOOKS) do if ROW[p] then task.spawn(h, ROW[p].val) end end
	task.spawn(function()
		local t0 = os.clock()
		while not state.loaderDone and os.clock() - t0 < 40 do task.wait(.1) end
		ready = true
		hudVisible = true
		updateHud()
		task.wait(.3)
		setOpen(true)
		task.wait(.1)
		selectTab(1, true)
	end)
end
