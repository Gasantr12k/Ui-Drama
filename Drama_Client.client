	-- Фигурка-заглушка (силуэт)
	local dummy = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1,0,1,-28), Position = UDim2.fromOffset(0,28)}, espPreview)

	local function mkEPLine(col) return new("Frame", {BackgroundColor3 = col, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5,0.5)}, dummy) end
	local function setLine(f, x1,y1,x2,y2,t)
		local dx,dy = x2-x1, y2-y1
		local len = math.sqrt(dx*dx+dy*dy)
		f.Position = UDim2.fromOffset((x1+x2)/2,(y1+y2)/2)
		f.Size = UDim2.fromOffset(len, t or 1.5)
		f.Rotation = math.deg(math.atan2(dy,dx))
	end

	-- Координаты силуэта (относительно dummy 140x172)
	local W2, H2 = 70, 86
	local cx = W2
	-- бокс
	local bx1,by1,bx2,by2 = cx-28, 8, cx+28, 168
	local boxColor = Color3.fromRGB(80,220,80)
	local bl = {mkEPLine(boxColor),mkEPLine(boxColor),mkEPLine(boxColor),mkEPLine(boxColor)}
	setLine(bl[1],bx1,by1,bx2,by1,1.5) -- top
	setLine(bl[2],bx1,by2,bx2,by2,1.5) -- bot
	setLine(bl[3],bx1,by1,bx1,by2,1.5) -- left
	setLine(bl[4],bx2,by1,bx2,by2,1.5) -- right

